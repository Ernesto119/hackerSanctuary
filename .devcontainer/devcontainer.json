{
  "name": "Ionic Angular DevSecOps",
  "build": {
    "dockerfile": "Dockerfile",
  },

  // 1. remoteUser: Mantiene el contenedor seguro sin privilegios de root
  "remoteUser": "node",

  // 2. containerEnv: Configuración del motor del contenedor y Node
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive",
    "TZ": "UTC",
    "NG_CLI_ANALYTICS": "false", // Desactiva la telemetría de Angular (privacidad)
  },

  // 3. remoteEnv: Variables inyectadas en tu sesión remota
  "remoteEnv": {
    "SHELL": "/usr/bin/zsh",
    "EDITOR": "zed",
    "GOOGLE_AI_API_KEY": "${localEnv:GOOGLE_AI_API_KEY}",
  },

  // Puertos comunes para Ionic y Angular (Live Reload)
  "forwardPorts": [8100, 4200],
  "portsAttributes": {
    "8100": {
      "label": "Ionic Serve",
      "onAutoForward": "notify",
    },
  },

  // Volúmenes y montajes para persistir historial y credenciales de IA
  "mounts": [
    "source=devcontainer-zshhistory,target=/home/devuser/.zshhistory,type=volume",
    // Persiste caché de npm para acelerar instalaciones futuras
    "source=devcontainer-npm-cache,target=/home/devuser/.npm,type=volume",
    // Monta la configuración de AntiGravity CLI desde tu host
    "source=${localEnv:HOME}/.gemini/,target=/home/devuser/.config/antigravity,type=bind,consistency=cached",
  ],

  // Comando post-creación opcional para verificar dependencias del proyecto si ya existen
  "postCreateCommand": "node -v && npm -v && ionic -v",
}
